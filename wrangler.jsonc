{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-15",
	"name": "maheshbishnoi-com",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "maheshbishnoi.com", "custom_domain": true },
		{ "pattern": "www.maheshbishnoi.com", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}
