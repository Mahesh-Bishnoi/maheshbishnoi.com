---
import Base from "../layouts/Base.astro";
---

<Base title="Mahesh Bishnoi — Portfolio" canonical="https://maheshbishnoi.com/" current="home">
  <div class="hero">
    <h1>Hi, I'm Mahesh.</h1>
    <p class="lead">I build things for the web — focused on performance, reliability, and clean engineering.</p>
    <div class="btn-row">
      <a class="btn" href="/resume/">View resume</a>
      <a class="btn ghost" href="/blog/">Read the blog</a>
    </div>
  </div>

  <section>
    <h2>What I do</h2>
    <div class="grid">
      <div class="card"><h3>Web platforms</h3><p>Static sites and Workers-deployed apps that are fast by default.</p></div>
      <div class="card"><h3>Cloud &amp; edge</h3><p>Cloudflare Workers, caching, and zero-origin architectures.</p></div>
      <div class="card"><h3>Writing</h3><p>Notes on shipping, tooling, and the boring tech that works.</p></div>
    </div>
  </section>

  <section>
    <h2>Latest writing</h2>
    <ul class="post-list">
      <li><a href="/blog/hello-world/">Hello world — what this site is for</a><time>Oct 2026</time></li>
    </ul>
  </section>
</Base>
